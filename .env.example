# Japan Travel App — Environment Variables Template
# 使用方式：複製此檔為 .env，填入實際值
# 嚴禁 commit .env 檔到 repo（見 .gitignore）

# === Django ===
DJANGO_SECRET_KEY=please-change-me-to-random-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# === Database ===
# Dev (SQLite) — 預設，不用填
# Prod (MySQL on PlanetScale)
# 格式：mysql://user:password@host/db_name?ssl-mode=REQUIRED
DATABASE_URL=sqlite:///db.sqlite3

# === Gemini API (晨楷) ===
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_RETRIES=3

# === Google Maps API (珥豪) ===
# Cloud Console 建立，設定受限網域
GOOGLE_MAPS_API_KEY=your-maps-api-key
GOOGLE_PLACES_API_KEY=your-places-api-key

# === RAG / ChromaDB (伯亨) ===
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=text-embedding-004

# === Frontend (Vite) ===
# 注意：VITE_ 前綴變數會暴露到 browser，只放前端可見的值
VITE_API_BASE_URL=http://localhost:8000/api
VITE_GOOGLE_MAPS_API_KEY=your-restricted-maps-key-for-browser

# === Deployment (Railway / Vercel) ===
# 這些由部署平台直接設定，不用寫在本地 .env
# RAILWAY_STATIC_URL=
# VERCEL_URL=

# === CORS (Backend) ===
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# === JWT ===
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7
